cat > test-vm1.yaml <<'EOF'
apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: test-vm
  namespace: default

spec:
  runStrategy: Always

  template:
    metadata:
      labels:
        kubevirt.io/domain: test-vm

    spec:
      domain:
        resources:
          requests:
            memory: 1Gi

        cpu:
          cores: 1

        devices:
          disks:

            # Fedora OS disk
            - name: containerdisk
              disk:
                bus: virtio

            # Cloud-init disk
            - name: cloudinitdisk
              disk:
                bus: virtio

          interfaces:

            # Primary Kube-OVN network
            - name: default
              masquerade: {}

            # Multus secondary network
            - name: secondary
              bridge: {}

      networks:

        # Primary network
        - name: default
          pod: {}

        # Multus network
        - name: secondary
          multus:
            networkName: default/secondary-net

      volumes:

        # Fedora OS
        - name: containerdisk
          containerDisk:
            image: quay.io/containerdisks/fedora:latest

        # Cloud-init
        - name: cloudinitdisk
          cloudInitNoCloud:
            userData: |
              #cloud-config

              user: fedora
              password: redhat
              chpasswd:
                expire: false

              ssh_pwauth: true

              packages:
                - openssh-server
                - vim
                - net-tools

              runcmd:
                - systemctl enable --now sshd
EOF


virtctl migrate test-vm
